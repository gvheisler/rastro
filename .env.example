# Banco de dados (Docker Compose)
POSTGRES_USER=rastro
POSTGRES_PASSWORD=rastro_dev
POSTGRES_DB=rastro
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
READONLY_USER=rastro_ro
READONLY_PASSWORD=rastro_ro_dev

# Modelo de linguagem. Deixe só um dos blocos abaixo ativo.

# 1. Ollama local (padrão). Rode `make model` antes.
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=rastro-sql
# LLM_EXTRA_BODY={"reasoning_effort": "none"}

# 2. API do Claude (Anthropic)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sua-chave
# LLM_EFFORT=low

# 3. Outro serviço compatível com a API da OpenAI (OpenAI, OpenRouter, Groq, vLLM...)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=nome-do-modelo
# LLM_API_KEY=sua-chave
# LLM_EXTRA_BODY={}
# LLM_TEMPERATURE=

# Fonte das transferências especiais
TRANSFEREGOV_BASE_URL=https://api-publica.transferegov.gestao.gov.br/especiais
